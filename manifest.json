{
  "manifest_version": 3,
  "name": "学习模式 Study Mode",
  "description": "浏览网页时把标签页标题和页面大标题替换成学习类标题，装上即默认生效。Replace tab & page titles with study-style titles.",
  "version": "1.3.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "//content_scripts": "matches 必须是 src/sites.js 中所有站点 match 的并集；以后加站点要同步这里",
  "content_scripts": [
    {
      "matches": [
        "https://*.zhihu.com/*"
      ],
      "js": [
        "src/sites.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "study-mode@z-zihan.dev",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
